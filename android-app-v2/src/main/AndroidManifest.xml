<?xml version="1.0" encoding="utf-8"?>
<!--
  GuardianLink v0.2 manifest.

  Component names are FULLY QUALIFIED (guardianlink.v2.app.*): the AGP
  namespace is guardianlink.app (PORT-MAP §e step 2) while the classes
  live in package guardianlink.v2.app, so relative ".Name" entries would
  resolve against the namespace and miss the classes.

  Permission/FGS declarations follow ANDROID-PORT-MAP §d. The sensing
  service runs three collectors — device state, location
  (LocationManager), motion (SensorManager) — and is declared
  "specialUse|location|health": the FOREGROUND_SERVICE_LOCATION /
  _HEALTH permissions are declared below, and startForeground passes
  exactly the types whose prerequisites are met (specialUse always;
  location only with a location grant; health only with the
  activity-recognition grant). Declaring a permission collects nothing
  by itself; a collector whose permission is absent names itself
  unavailable in the standing answers and emits no data.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync / connected services (Phase D transports; declared per §d) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service base + per-type permissions (§d global rules) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Location (§d: runtime; background requested separately/incrementally) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Motion / activity (§d: runtime permission, API 29+) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Device state: restart after reboot is an FGS-start exemption (§d) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- FGS notification visibility (runtime, API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice assent ceremony parity with the scaffold (§d audio) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Calendar collector: the phone's own calendar, behind this
         runtime grant; the collector names itself unavailable
         without it. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Device actions: the phone operated as the sovereign, each
         behind its own runtime grant and every use behind assent. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Health collector: Health Connect read grants (steps, heart
         rate, sleep, oxygen, weight), requested through the Health
         Connect permission flow, named in Permissions. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.connect.action.HEALTH_HOME_SETTINGS" />
        </intent>
    </queries>

    <!-- Presence (§d: normal permission for BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Interaction collector (future): special app-access, granted in
         Settings only; declared here per §d, not runtime-requestable. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:name="guardianlink.v2.app.GuardianLinkV2App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="GuardianLink v0.2"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name="guardianlink.v2.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="guardianlink.v2.app.SettingsActivity"
            android:exported="false" />

        <activity
            android:name="guardianlink.v2.app.VaultActivity"
            android:exported="false" />

        <!-- Assistant role (the summon). When GuardianLink is the
             device's default assistant, the system summon from any
             app routes to GlSessionService, which hands off to
             MainActivity already listening. The role is the
             sovereign's to grant or revoke in system settings;
             nothing here takes it. -->
        <service
            android:name="guardianlink.v2.app.GlVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>

        <service
            android:name="guardianlink.v2.app.GlSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>

        <service
            android:name="guardianlink.v2.app.GlRecognitionService"
            android:exported="true"
            android:label="GuardianLink recognition">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <activity
            android:name="guardianlink.v2.app.PermissionsActivity"
            android:exported="false"
            android:label="GuardianLink permissions" />

        <service
            android:name="guardianlink.v2.app.SensingService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|health|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous on-device context sensing (device state, location, motion) feeding the sovereign's GuardianLink standing questions. All collection is rail-governed, visible in-app, and revocable; denied or unavailable sources degrade answers honestly instead of fabricating data." />
        </service>

        <!-- Notification context: the mail/messaging notifications
             the phone's own signed-in apps post. The system binds
             this service only after the sovereign grants
             notification access in system settings. -->
        <service
            android:name="guardianlink.v2.app.GlNotificationListener"
            android:label="GuardianLink notification context"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Device control ("fingers"): acts inside other apps ONLY
             when a governed proposal clears assent and DeviceControl
             invokes it. Inert on its own; enabled by the sovereign
             in system accessibility settings. -->
        <service
            android:name="guardianlink.v2.app.GlAccessibilityService"
            android:label="GuardianLink device control"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- SMS send confirmation postbox: reached only by this
             app's own PendingIntents (explicit component), which is
             what lets the carrier's answer back in. -->
        <receiver
            android:name="guardianlink.v2.app.SmsSentReceiver"
            android:exported="false" />

        <receiver
            android:name="guardianlink.v2.app.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
