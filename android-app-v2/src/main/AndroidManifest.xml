<?xml version="1.0" encoding="utf-8"?>
<!--
  GuardianLink v0.2 manifest.

  Component names are FULLY QUALIFIED (guardianlink.v2.app.*): the AGP
  namespace is guardianlink.app (PORT-MAP §e step 2) while the classes
  live in package guardianlink.v2.app, so relative ".Name" entries would
  resolve against the namespace and miss the classes.

  Permission/FGS declarations follow ANDROID-PORT-MAP §d. The sensing
  service runs three collectors — device state, location
  (LocationManager), motion (SensorManager) — and is declared
  "specialUse|location|health": the FOREGROUND_SERVICE_LOCATION /
  _HEALTH permissions are declared below, and startForeground passes
  exactly the types whose prerequisites are met (specialUse always;
  location only with a location grant; health only with the
  activity-recognition grant). Declaring a permission collects nothing
  by itself; a collector whose permission is absent names itself
  unavailable in the standing answers and emits no data.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync / connected services (Phase D transports; declared per §d) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service base + per-type permissions (§d global rules) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Location (§d: runtime; background requested separately/incrementally) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Motion / activity (§d: runtime permission, API 29+) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Device state: restart after reboot is an FGS-start exemption (§d) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- FGS notification visibility (runtime, API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice assent ceremony parity with the scaffold (§d audio) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Presence (§d: normal permission for BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Interaction collector (future): special app-access, granted in
         Settings only; declared here per §d, not runtime-requestable. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:name="guardianlink.v2.app.GuardianLinkV2App"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="GuardianLink v0.2"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name="guardianlink.v2.app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="guardianlink.v2.app.SettingsActivity"
            android:exported="false" />

        <activity
            android:name="guardianlink.v2.app.VaultActivity"
            android:exported="false" />

        <activity
            android:name="guardianlink.v2.app.PermissionsActivity"
            android:exported="false"
            android:label="GuardianLink permissions" />

        <service
            android:name="guardianlink.v2.app.SensingService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location|health">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous on-device context sensing (device state, location, motion) feeding the sovereign's GuardianLink standing questions. All collection is rail-governed, visible in-app, and revocable; denied or unavailable sources degrade answers honestly instead of fabricating data." />
        </service>

        <receiver
            android:name="guardianlink.v2.app.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
